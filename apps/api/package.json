{
  "name": "@fintech/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=src/config/.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fintech/api-contracts": "*",
    "@fintech/i18n": "*",
    "@fintech/types": "^0.0.1",
    "@fintech/validation": "*",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "joi": "^18.2.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13"
  },
  "nx": {
    "name": "api",
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
